pragma silverscript ^0.1.0;

contract MinterProxy(byte[32] gen__init_kcc20_template, byte[32] init_controller_id) {
    struct KCC20State {
        byte[32] owner_identifier;
        byte identifier_type;
        int amount;
    }

    struct MinterProxyState {
        byte[32] controller_id;
    }

    byte[32] gen__kcc20_template = gen__init_kcc20_template;

    byte[32] controller_id = init_controller_id;

    byte constant IDENTIFIER_PUBKEY = 0;

    byte constant IDENTIFIER_COVENANT_ID = 2;

    entry mint(MinterProxyState next_proxy, KCC20State recipient_state, byte[] gen__kcc20_prefix, byte[] gen__kcc20_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 2);
        int gen__proxy_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        int gen__recipient_output_idx = OpAuthOutputIdx(this.activeInputIndex, 1);
        require(OpCovInputCount(controller_id) > 0);
        require(next_proxy.controller_id == controller_id);
        State gen__0_route_physical_proxy = State {gen__kcc20_template: gen__kcc20_template, controller_id: next_proxy.controller_id};
        validateOutputState(gen__proxy_output_idx, gen__0_route_physical_proxy);
        validateOutputStateWithTemplate(gen__recipient_output_idx, recipient_state, gen__kcc20_prefix, gen__kcc20_suffix, gen__kcc20_template);
    }
}
