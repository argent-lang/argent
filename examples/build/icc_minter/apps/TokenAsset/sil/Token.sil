pragma silverscript ^0.1.0;

contract Token(byte[32] init_owner_identifier, byte init_identifier_type, int init_amount) {
    struct MinterProxyState {
        byte[32] controller_id;
    }

    byte[32] owner_identifier = init_owner_identifier;

    byte identifier_type = init_identifier_type;

    int amount = init_amount;

    byte constant IDENTIFIER_PUBKEY = 0;

    byte constant IDENTIFIER_COVENANT_ID = 2;

    entry transfer(byte[32] new_owner_identifier, byte new_identifier_type, sig owner_sig) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        if (identifier_type == IDENTIFIER_PUBKEY) {
            require(checkSig(owner_sig, pubkey(owner_identifier)));
        } else {
            if (identifier_type == IDENTIFIER_COVENANT_ID) {
                require(OpCovInputCount(owner_identifier) > 0);
            } else {
                require(false);
            }
        }
        State next_state = State {owner_identifier: new_owner_identifier, identifier_type: new_identifier_type, amount: amount};
        validateOutputState(gen__next_output_idx, next_state);
    }
}
