pragma silverscript ^0.1.0;

contract Mux(byte[32] gen__init_archive_template, byte[32] gen__init_mux_template, byte[64] gen__init_mux_routes, int init_ply) {
    struct LobbyState {
        int nonce;
    }

    struct BoardState {
        int ply;
    }

    struct ArchiveState {
        int final_ply;
    }

    struct Gen__ArchiveState {
        byte[32] gen__archive_template;
        byte[32] gen__mux_template;
        byte[32] gen__mux_routes_digest;
        int final_ply;
    }

    byte[32] gen__archive_template = gen__init_archive_template;

    byte[32] gen__mux_template = gen__init_mux_template;

    byte[64] gen__mux_routes = gen__init_mux_routes;

    int ply = init_ply;

    entry choose(int target, byte[] gen__target_prefix, byte[] gen__target_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        BoardState next_board = BoardState {ply: ply + 1};
        State gen__0_route_physical_next = State {gen__archive_template: gen__archive_template, gen__mux_template: gen__mux_template, gen__mux_routes: gen__mux_routes, ply: next_board.ply};
        int gen__target_selector = target;
        require(gen__target_selector >= 0);
        require(gen__target_selector < 2);
        byte[32] gen__target_template = byte[32](gen__mux_routes.slice(gen__target_selector * 32, gen__target_selector * 32 + 32));
        validateOutputStateWithTemplate(gen__next_output_idx, gen__0_route_physical_next, gen__target_prefix, gen__target_suffix, gen__target_template);
    }

    entry archive(byte[] gen__archive_prefix, byte[] gen__archive_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        ArchiveState next_archive = ArchiveState {final_ply: ply};
        Gen__ArchiveState gen__0_route_physical_next = Gen__ArchiveState {gen__archive_template: gen__archive_template, gen__mux_template: gen__mux_template, gen__mux_routes_digest: blake3(byte[](gen__mux_routes)), final_ply: next_archive.final_ply};
        validateOutputStateWithTemplate(gen__next_output_idx, gen__0_route_physical_next, gen__archive_prefix, gen__archive_suffix, gen__archive_template);
    }
}
