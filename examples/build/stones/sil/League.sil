pragma silverscript ^0.1.0;

contract League(byte[32] gen__init_player_template, byte[32] gen__init_stones_game_template, byte[32] gen__init_stones_settle_template, byte[32] init_admin, int init_default_pile, int init_default_max_take) {
    struct LeagueState {
        byte[32] admin;
        int default_pile;
        int default_max_take;
    }

    struct PlayerState {
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int games;
        int wins;
        int losses;
    }

    struct GameState {
        byte[32] player_a;
        byte[32] player_b;
        int pile;
        int max_take;
        int turn;
    }

    struct SettleState {
        byte[32] player_a;
        byte[32] player_b;
        int status;
    }

    struct Gen__PlayerState {
        byte[32] gen__player_template;
        byte[32] gen__stones_game_template;
        byte[32] gen__stones_settle_template;
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int games;
        int wins;
        int losses;
    }

    byte[32] gen__player_template = gen__init_player_template;

    byte[32] gen__stones_game_template = gen__init_stones_game_template;

    byte[32] gen__stones_settle_template = gen__init_stones_settle_template;

    byte[32] admin = init_admin;

    int default_pile = init_default_pile;

    int default_max_take = init_default_max_take;

    int constant SIDE_A = 0;

    int constant SIDE_B = 1;

    int constant LIVE = 0;

    int constant A_WIN = 1;

    int constant B_WIN = 2;

    function player_ref(byte[32] gen__glob_owner, byte[32] gen__glob_player_id): byte[32] {
        return(blake2b(byte[](gen__glob_owner + gen__glob_player_id)));
    }

    function side_player(int gen__glob_side, byte[32] gen__glob_a_ref, byte[32] gen__glob_b_ref): byte[32] {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        byte[32] gen__glob_result = gen__glob_b_ref;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = gen__glob_a_ref;
        }
        return(gen__glob_result);
    }

    function other_side(int gen__glob_side): int {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        int gen__glob_result = SIDE_A;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = SIDE_B;
        }
        return(gen__glob_result);
    }

    function win_status(int gen__glob_side): int {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        int gen__glob_result = B_WIN;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = A_WIN;
        }
        return(gen__glob_result);
    }

    function invocation_uid(byte[] gen__glob_domain): byte[32] {
        require(gen__glob_domain.length > 0);
        byte[36] gen__glob_outpoint = byte[36](OpOutpointTxId(this.activeInputIndex) + OpOutpointIndex(this.activeInputIndex) as byte[4]);
        return(blake2bWithKey(byte[](gen__glob_outpoint), gen__glob_domain));
    }

    entry register_player(sig owner_sig, pubkey owner_pk, byte[] gen__player_prefix, byte[] gen__player_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 2);
        int gen__league_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        int gen__player_output_idx = OpAuthOutputIdx(this.activeInputIndex, 1);
        require(checkSig(owner_sig, owner_pk));
        byte[32] owner = blake2b(byte[](owner_pk));
        byte[32] player_id = invocation_uid(byte[]("StonesPlayer"));
        PlayerState next_player = PlayerState {owner: owner, player_id: player_id, open_games: 0, games: 0, wins: 0, losses: 0};
        require(tx.outputs[gen__league_output_idx].value == tx.inputs[this.activeInputIndex].value);
        require(tx.outputs[gen__player_output_idx].value > 0);
        require(tx.outputs[gen__league_output_idx].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);
        Gen__PlayerState gen__1_route_physical_player = Gen__PlayerState {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, owner: next_player.owner, player_id: next_player.player_id, open_games: next_player.open_games, games: next_player.games, wins: next_player.wins, losses: next_player.losses};
        validateOutputStateWithTemplate(gen__player_output_idx, gen__1_route_physical_player, gen__player_prefix, gen__player_suffix, gen__player_template);
    }
}
