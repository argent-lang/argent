pragma silverscript ^0.1.0;

contract Player(byte[32] gen__init_player_template, byte[32] gen__init_stones_game_template, byte[32] gen__init_stones_settle_template, byte[32] init_owner, byte[32] init_player_id, int init_open_games, int init_games, int init_wins, int init_losses) {
    struct LeagueState {
        byte[32] admin;
        int default_pile;
        int default_max_take;
    }

    struct PlayerState {
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int games;
        int wins;
        int losses;
    }

    struct GameState {
        byte[32] player_a;
        byte[32] player_b;
        int pile;
        int max_take;
        int turn;
    }

    struct SettleState {
        byte[32] player_a;
        byte[32] player_b;
        int status;
    }

    struct Gen__StonesGameState {
        byte[32] gen__player_template;
        byte[32] gen__stones_game_template;
        byte[32] gen__stones_settle_template;
        byte[32] player_a;
        byte[32] player_b;
        int pile;
        int max_take;
        int turn;
    }

    struct Gen__StonesSettleState {
        byte[32] gen__player_template;
        byte[32] gen__stones_game_template;
        byte[32] gen__stones_settle_template;
        byte[32] player_a;
        byte[32] player_b;
        int status;
    }

    byte[32] gen__player_template = gen__init_player_template;

    byte[32] gen__stones_game_template = gen__init_stones_game_template;

    byte[32] gen__stones_settle_template = gen__init_stones_settle_template;

    byte[32] owner = init_owner;

    byte[32] player_id = init_player_id;

    int open_games = init_open_games;

    int games = init_games;

    int wins = init_wins;

    int losses = init_losses;

    int constant SIDE_A = 0;

    int constant SIDE_B = 1;

    int constant LIVE = 0;

    int constant A_WIN = 1;

    int constant B_WIN = 2;

    byte[4] constant gen__const_player_prefix_len = byte[4](0x01000000);

    byte[4] constant gen__const_player_suffix_len = byte[4](0xef090000);

    function player_ref(byte[32] gen__glob_owner, byte[32] gen__glob_player_id): byte[32] {
        return(blake2b(byte[](gen__glob_owner + gen__glob_player_id)));
    }

    function side_player(int gen__glob_side, byte[32] gen__glob_a_ref, byte[32] gen__glob_b_ref): byte[32] {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        byte[32] gen__glob_result = gen__glob_b_ref;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = gen__glob_a_ref;
        }
        return(gen__glob_result);
    }

    function other_side(int gen__glob_side): int {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        int gen__glob_result = SIDE_A;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = SIDE_B;
        }
        return(gen__glob_result);
    }

    function win_status(int gen__glob_side): int {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        int gen__glob_result = B_WIN;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = A_WIN;
        }
        return(gen__glob_result);
    }

    function invocation_uid(byte[] gen__glob_domain): byte[32] {
        require(gen__glob_domain.length > 0);
        byte[36] gen__glob_outpoint = byte[36](OpOutpointTxId(this.activeInputIndex) + OpOutpointIndex(this.activeInputIndex) as byte[4]);
        return(blake2bWithKey(byte[](gen__glob_outpoint), gen__glob_domain));
    }

    entry start_game(sig owner_sig, pubkey owner_pk, int first_turn, int pile, int max_take, byte[] gen__stones_game_prefix, byte[] gen__stones_game_suffix) {
        int gen__player_prefix_len = int(gen__const_player_prefix_len);
        int gen__player_suffix_len = int(gen__const_player_suffix_len);
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) == 2);
        require(OpCovInputIdx(gen__cov_id, 0) == this.activeInputIndex);
        int gen__opponent_input_idx = OpCovInputIdx(gen__cov_id, 1);
        State gen__opponent_state = readInputStateWithTemplate(gen__opponent_input_idx, gen__player_prefix_len, gen__player_suffix_len, gen__player_template);
        require(OpAuthOutputCount(this.activeInputIndex) == 3);
        int gen__self_out_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        int gen__opponent_out_output_idx = OpAuthOutputIdx(this.activeInputIndex, 1);
        int gen__game_output_idx = OpAuthOutputIdx(this.activeInputIndex, 2);
        require(OpCovOutputCount(gen__cov_id) == OpAuthOutputCount(this.activeInputIndex));
        require(blake2b(byte[](owner_pk)) == owner);
        require(checkSig(owner_sig, owner_pk));
        require(gen__opponent_state.player_id != player_id);
        require(first_turn == SIDE_A || first_turn == SIDE_B);
        require(pile > 0);
        require(max_take > 0);
        byte[32] self_ref = player_ref(owner, player_id);
        byte[32] opponent_ref = player_ref(gen__opponent_state.owner, gen__opponent_state.player_id);
        PlayerState next_self = PlayerState {owner: owner, player_id: player_id, open_games: open_games + 1, games: games, wins: wins, losses: losses};
        PlayerState next_opponent = PlayerState {owner: gen__opponent_state.owner, player_id: gen__opponent_state.player_id, open_games: gen__opponent_state.open_games + 1, games: gen__opponent_state.games, wins: gen__opponent_state.wins, losses: gen__opponent_state.losses};
        GameState next_game = GameState {player_a: self_ref, player_b: opponent_ref, pile: pile, max_take: max_take, turn: first_turn};
        require(tx.outputs[gen__self_out_output_idx].value == tx.inputs[this.activeInputIndex].value);
        require(tx.outputs[gen__opponent_out_output_idx].value == tx.inputs[gen__opponent_input_idx].value);
        require(tx.outputs[gen__game_output_idx].value > 0);
        State gen__0_route_physical_self_out = State {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, owner: next_self.owner, player_id: next_self.player_id, open_games: next_self.open_games, games: next_self.games, wins: next_self.wins, losses: next_self.losses};
        validateOutputState(gen__self_out_output_idx, gen__0_route_physical_self_out);
        State gen__1_route_physical_opponent_out = State {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, owner: next_opponent.owner, player_id: next_opponent.player_id, open_games: next_opponent.open_games, games: next_opponent.games, wins: next_opponent.wins, losses: next_opponent.losses};
        validateOutputState(gen__opponent_out_output_idx, gen__1_route_physical_opponent_out);
        Gen__StonesGameState gen__2_route_physical_game = Gen__StonesGameState {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, player_a: next_game.player_a, player_b: next_game.player_b, pile: next_game.pile, max_take: next_game.max_take, turn: next_game.turn};
        validateOutputStateWithTemplate(gen__game_output_idx, gen__2_route_physical_game, gen__stones_game_prefix, gen__stones_game_suffix, gen__stones_game_template);
    }

    entry accept_start(sig owner_sig, pubkey owner_pk) {
        int gen__player_prefix_len = int(gen__const_player_prefix_len);
        int gen__player_suffix_len = int(gen__const_player_suffix_len);
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) >= 2);
        require(OpCovInputIdx(gen__cov_id, 0) != this.activeInputIndex);
        int gen__starter_input_idx = OpCovInputIdx(gen__cov_id, 0);
        State gen__starter_state = readInputStateWithTemplate(gen__starter_input_idx, gen__player_prefix_len, gen__player_suffix_len, gen__player_template);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(blake2b(byte[](owner_pk)) == owner);
        require(checkSig(owner_sig, owner_pk));
        require(gen__starter_state.player_id != player_id);
    }

    entry settle(int gen__stones_settle_prefix_len, int gen__stones_settle_suffix_len) {
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) >= 2);
        require(OpCovInputIdx(gen__cov_id, 0) != this.activeInputIndex);
        int gen__settle_input_idx = OpCovInputIdx(gen__cov_id, 0);
        Gen__StonesSettleState gen__settle_state = readInputStateWithTemplate(gen__settle_input_idx, gen__stones_settle_prefix_len, gen__stones_settle_suffix_len, gen__stones_settle_template);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        byte[32] self_ref = player_ref(owner, player_id);
        require(self_ref == gen__settle_state.player_a || self_ref == gen__settle_state.player_b);
    }

    entry retire(sig owner_sig, pubkey owner_pk) {
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(gen__cov_id) == 1);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(blake2b(byte[](owner_pk)) == owner);
        require(checkSig(owner_sig, owner_pk));
        require(open_games == 0);
    }
}
