pragma silverscript ^0.1.0;

contract StonesGame(byte[32] gen__init_player_template, byte[32] gen__init_stones_game_template, byte[32] gen__init_stones_settle_template, byte[32] init_player_a, byte[32] init_player_b, int init_pile, int init_max_take, int init_turn) {
    struct LeagueState {
        byte[32] admin;
        int default_pile;
        int default_max_take;
    }

    struct PlayerState {
        byte[32] owner;
        byte[32] player_id;
        int open_games;
        int games;
        int wins;
        int losses;
    }

    struct GameState {
        byte[32] player_a;
        byte[32] player_b;
        int pile;
        int max_take;
        int turn;
    }

    struct SettleState {
        byte[32] player_a;
        byte[32] player_b;
        int status;
    }

    struct Gen__StonesSettleState {
        byte[32] gen__player_template;
        byte[32] gen__stones_game_template;
        byte[32] gen__stones_settle_template;
        byte[32] player_a;
        byte[32] player_b;
        int status;
    }

    byte[32] gen__player_template = gen__init_player_template;

    byte[32] gen__stones_game_template = gen__init_stones_game_template;

    byte[32] gen__stones_settle_template = gen__init_stones_settle_template;

    byte[32] player_a = init_player_a;

    byte[32] player_b = init_player_b;

    int pile = init_pile;

    int max_take = init_max_take;

    int turn = init_turn;

    int constant SIDE_A = 0;

    int constant SIDE_B = 1;

    int constant LIVE = 0;

    int constant A_WIN = 1;

    int constant B_WIN = 2;

    function player_ref(byte[32] gen__glob_owner, byte[32] gen__glob_player_id): byte[32] {
        return(blake2b(byte[](gen__glob_owner + gen__glob_player_id)));
    }

    function side_player(int gen__glob_side, byte[32] gen__glob_a_ref, byte[32] gen__glob_b_ref): byte[32] {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        byte[32] gen__glob_result = gen__glob_b_ref;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = gen__glob_a_ref;
        }
        return(gen__glob_result);
    }

    function other_side(int gen__glob_side): int {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        int gen__glob_result = SIDE_A;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = SIDE_B;
        }
        return(gen__glob_result);
    }

    function win_status(int gen__glob_side): int {
        require(gen__glob_side == SIDE_A || gen__glob_side == SIDE_B);
        int gen__glob_result = B_WIN;
        if (gen__glob_side == SIDE_A) {
            gen__glob_result = A_WIN;
        }
        return(gen__glob_result);
    }

    function invocation_uid(byte[] gen__glob_domain): byte[32] {
        require(gen__glob_domain.length > 0);
        byte[36] gen__glob_outpoint = byte[36](OpOutpointTxId(this.activeInputIndex) + OpOutpointIndex(this.activeInputIndex) as byte[4]);
        return(blake2bWithKey(byte[](gen__glob_outpoint), gen__glob_domain));
    }

    entry take(int amount, byte[32] player_id, sig move_sig, pubkey move_pk, byte[] gen__stones_settle_prefix, byte[] gen__stones_settle_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(pile > 0);
        require(amount >= 1);
        require(amount <= max_take);
        require(amount <= pile);
        byte[32] actor_ref = player_ref(blake2b(byte[](move_pk)), player_id);
        byte[32] expected_ref = side_player(turn, player_a, player_b);
        require(actor_ref == expected_ref);
        require(checkSig(move_sig, move_pk));
        int next_pile = pile - amount;
        require(tx.outputs[gen__next_output_idx].value == tx.inputs[this.activeInputIndex].value);
        if (next_pile == 0) {
            SettleState ticket = SettleState {player_a: player_a, player_b: player_b, status: win_status(turn)};
            Gen__StonesSettleState gen__0_route_physical_next = Gen__StonesSettleState {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, player_a: ticket.player_a, player_b: ticket.player_b, status: ticket.status};
            validateOutputStateWithTemplate(gen__next_output_idx, gen__0_route_physical_next, gen__stones_settle_prefix, gen__stones_settle_suffix, gen__stones_settle_template);
        } else {
            GameState next_game = GameState {player_a: player_a, player_b: player_b, pile: next_pile, max_take: max_take, turn: other_side(turn)};
            State gen__1_route_physical_next = State {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, player_a: next_game.player_a, player_b: next_game.player_b, pile: next_game.pile, max_take: next_game.max_take, turn: next_game.turn};
            validateOutputState(gen__next_output_idx, gen__1_route_physical_next);
        }
    }

    entry concede(byte[32] player_id, sig move_sig, pubkey move_pk, byte[] gen__stones_settle_prefix, byte[] gen__stones_settle_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__settle_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        byte[32] actor_ref = player_ref(blake2b(byte[](move_pk)), player_id);
        byte[32] expected_ref = side_player(turn, player_a, player_b);
        require(actor_ref == expected_ref);
        require(checkSig(move_sig, move_pk));
        require(tx.outputs[gen__settle_output_idx].value == tx.inputs[this.activeInputIndex].value);
        int winner = other_side(turn);
        SettleState ticket = SettleState {player_a: player_a, player_b: player_b, status: win_status(winner)};
        Gen__StonesSettleState gen__0_route_physical_settle = Gen__StonesSettleState {gen__player_template: gen__player_template, gen__stones_game_template: gen__stones_game_template, gen__stones_settle_template: gen__stones_settle_template, player_a: ticket.player_a, player_b: ticket.player_b, status: ticket.status};
        validateOutputStateWithTemplate(gen__settle_output_idx, gen__0_route_physical_settle, gen__stones_settle_prefix, gen__stones_settle_suffix, gen__stones_settle_template);
    }
}
