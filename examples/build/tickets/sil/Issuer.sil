pragma silverscript ^0.1.0;

contract Issuer(byte[32] gen__init_ticket_template, byte[32] init_admin, int init_next_serial) {
    struct IssuerState {
        byte[32] admin;
        int next_serial;
    }

    struct TicketState {
        byte[32] owner;
        int serial;
        int redeemed;
    }

    byte[32] gen__ticket_template = gen__init_ticket_template;

    byte[32] admin = init_admin;

    int next_serial = init_next_serial;

    entry issue(sig admin_sig, pubkey admin_pk, pubkey owner_pk, byte[] gen__ticket_prefix, byte[] gen__ticket_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 2);
        int gen__issuer_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        int gen__ticket_output_idx = OpAuthOutputIdx(this.activeInputIndex, 1);
        require(blake2b(byte[](admin_pk)) == admin);
        require(checkSig(admin_sig, admin_pk));
        int serial = next_serial;
        byte[32] owner = blake2b(byte[](owner_pk));
        IssuerState next_issuer = IssuerState {admin: admin, next_serial: next_serial + 1};
        TicketState new_ticket = TicketState {owner: owner, serial: serial, redeemed: 0};
        require(tx.outputs[gen__issuer_output_idx].value == tx.inputs[this.activeInputIndex].value);
        require(tx.outputs[gen__ticket_output_idx].value > 0);
        State gen__0_route_physical_issuer = State {gen__ticket_template: gen__ticket_template, admin: next_issuer.admin, next_serial: next_issuer.next_serial};
        validateOutputState(gen__issuer_output_idx, gen__0_route_physical_issuer);
        validateOutputStateWithTemplate(gen__ticket_output_idx, new_ticket, gen__ticket_prefix, gen__ticket_suffix, gen__ticket_template);
    }
}
