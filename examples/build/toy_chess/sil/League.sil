pragma silverscript ^0.1.0;

contract League(byte[32] gen__init_mux_template, byte[32] gen__init_player_template, byte[32] gen__init_mux_routes_digest, int init_nonce) {
    struct LeagueState {
        int nonce;
    }

    struct PlayerState {
        int nonce;
    }

    struct BoardState {
        int selector;
        int ply;
    }

    struct Gen__PlayerState {
        byte[32] gen__mux_template;
        byte[32] gen__mux_routes_digest;
        int nonce;
    }

    byte[32] gen__mux_template = gen__init_mux_template;

    byte[32] gen__player_template = gen__init_player_template;

    byte[32] gen__mux_routes_digest = gen__init_mux_routes_digest;

    int nonce = init_nonce;

    entry register(byte[] gen__player_prefix, byte[] gen__player_suffix) {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        PlayerState next_player = PlayerState {nonce: nonce + 1};
        Gen__PlayerState gen__0_route_physical_next = Gen__PlayerState {gen__mux_template: gen__mux_template, gen__mux_routes_digest: gen__mux_routes_digest, nonce: next_player.nonce};
        validateOutputStateWithTemplate(gen__next_output_idx, gen__0_route_physical_next, gen__player_prefix, gen__player_suffix, gen__player_template);
    }
}
