pragma silverscript ^0.1.0;

contract Player(byte[32] gen__init_mux_template, byte[32] gen__init_mux_routes_digest, int init_nonce) {
    struct LeagueState {
        int nonce;
    }

    struct PlayerState {
        int nonce;
    }

    struct BoardState {
        int selector;
        int ply;
    }

    struct Gen__MuxState {
        byte[32] gen__mux_template;
        byte[64] gen__mux_routes;
        int selector;
        int ply;
    }

    byte[32] gen__mux_template = gen__init_mux_template;

    byte[32] gen__mux_routes_digest = gen__init_mux_routes_digest;

    int nonce = init_nonce;

    entry enter_mux(byte[] gen__mux_prefix, byte[] gen__mux_suffix, byte[64] gen__mux_routes) {
        require(blake3(byte[](gen__mux_routes)) == gen__mux_routes_digest);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        BoardState next_board = BoardState {selector: nonce, ply: 0};
        Gen__MuxState gen__0_route_physical_next = Gen__MuxState {gen__mux_template: gen__mux_template, gen__mux_routes: gen__mux_routes, selector: next_board.selector, ply: next_board.ply};
        validateOutputStateWithTemplate(gen__next_output_idx, gen__0_route_physical_next, gen__mux_prefix, gen__mux_suffix, gen__mux_template);
    }
}
