// Token asset covenant family used by the ICC mint controller example.

const byte IDENTIFIER_PUBKEY = 0x00;
const byte IDENTIFIER_COVENANT_ID = 0x02;

state TokenState {
    byte[32] owner_identifier;
    byte identifier_type;
    int amount;
}

state MinterProxyState {
    cov_id controller_id;
}

actor Token owns TokenState {
    entry transfer(
        byte[32] new_owner_identifier,
        byte new_identifier_type,
        sig owner_sig
    ) emits {
        next: Token,
    } {
        if (identifier_type == IDENTIFIER_PUBKEY) {
            require(checkSig(owner_sig, pubkey(owner_identifier)));
        } else if (identifier_type == IDENTIFIER_COVENANT_ID) {
            require(cov_id(owner_identifier).co_spent());
        } else {
            require(false);
        }

        TokenState next_state = {
            owner_identifier: new_owner_identifier,
            identifier_type: new_identifier_type,
            amount: amount,
        };

        unrestricted(next.value);
        become next <- Token(next_state);
    }
}

actor MinterProxy owns MinterProxyState {
    entry mint(
        MinterProxyState next_proxy,
        TokenState recipient_state
    ) emits {
        proxy: MinterProxy,
        recipient: Token,
    } {
        require(controller_id.co_spent());
        require(next_proxy.controller_id == controller_id);

        unrestricted(proxy.value);
        unrestricted(recipient.value);
        become {
            proxy <- MinterProxy(next_proxy),
            recipient <- Token(recipient_state),
        };
    }
}

app TokenAsset {
    actor Token;
    actor MinterProxy;
}
