// Shared constants, state layouts, and helpers for the Stones app.

const int SIDE_A = 0;
const int SIDE_B = 1;

const int LIVE = 0;
const int A_WIN = 1;
const int B_WIN = 2;

// Shared state layouts are defined once and imported by actors.
state LeagueState {
    byte[32] admin;
    int default_pile;
    int default_max_take;
}

state PlayerState {
    byte[32] owner;
    byte[32] player_id;
    int open_games;
    int games;
    int wins;
    int losses;
}

state GameState {
    byte[32] player_a;
    byte[32] player_b;
    int pile;
    int max_take;
    int turn;
}

state SettleState {
    byte[32] player_a;
    byte[32] player_b;
    int status;
}

fn player_ref(byte[32] owner_, byte[32] player_id_) -> byte[32] {
    return blake2b(byte[](owner_ + player_id_));
}

fn side_player(int side_, byte[32] a_ref_, byte[32] b_ref_) -> byte[32] {
    require(side_ == SIDE_A || side_ == SIDE_B);
    byte[32] result_ = b_ref_;
    if (side_ == SIDE_A) {
        result_ = a_ref_;
    }
    return result_;
}

fn other_side(int side_) -> int {
    require(side_ == SIDE_A || side_ == SIDE_B);
    int result_ = SIDE_A;
    if (side_ == SIDE_A) {
        result_ = SIDE_B;
    }
    return result_;
}

fn win_status(int side_) -> int {
    require(side_ == SIDE_A || side_ == SIDE_B);
    int result_ = B_WIN;
    if (side_ == SIDE_A) {
        result_ = A_WIN;
    }
    return result_;
}
