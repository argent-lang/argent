pragma silverscript ^0.1.0;

contract ReserveAsset(byte[32] gen__init_reserve_asset_template, byte[32] gen__init_wallet_asset_template, int init_owner_kind, byte[32] init_owner_id, byte[32] init_policy, int init_balance) {
    struct ReserveAssetState {
        int owner_kind;
        byte[32] owner_id;
        ReservePolicy policy;
        int balance;
    }

    struct AssetCapsule {
        int owner_kind;
        byte[32] owner_id;
        byte[32] policy;
        int balance;
    }

    struct ReservePolicy {
        int nonce;
    }

    byte[32] gen__reserve_asset_template = gen__init_reserve_asset_template;

    byte[32] gen__wallet_asset_template = gen__init_wallet_asset_template;

    int owner_kind = init_owner_kind;

    byte[32] owner_id = init_owner_id;

    byte[32] policy = init_policy;

    int balance = init_balance;

    entry settle(int next_balance, byte[8] gen__policy_reserve_policy_preimage) {
        require(blake3(byte[](gen__policy_reserve_policy_preimage)) == policy);
        int gen__policy_nonce = OpBin2Num(gen__policy_reserve_policy_preimage.slice(0, 8));
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(OpCovInputCount(owner_id) > 0);
        ReserveAssetState next_asset = ReserveAssetState {owner_kind: owner_kind, owner_id: owner_id, policy: ReservePolicy {nonce: gen__policy_nonce + 1}, balance: next_balance};
        State gen__0_route_physical_next = State {gen__reserve_asset_template: gen__reserve_asset_template, gen__wallet_asset_template: gen__wallet_asset_template, owner_kind: next_asset.owner_kind, owner_id: next_asset.owner_id, policy: blake3(byte[](next_asset.policy.nonce as byte[8])), balance: next_asset.balance};
        validateOutputState(gen__next_output_idx, gen__0_route_physical_next);
    }

    entry withdraw(int next_balance, byte[] gen__wallet_asset_prefix, byte[] gen__wallet_asset_suffix, byte[8] gen__policy_reserve_policy_preimage) {
        require(blake3(byte[](gen__policy_reserve_policy_preimage)) == policy);
        int gen__policy_nonce = OpBin2Num(gen__policy_reserve_policy_preimage.slice(0, 8));
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(OpCovInputCount(owner_id) > 0);
        ReserveAssetState next_asset = ReserveAssetState {owner_kind: owner_kind, owner_id: owner_id, policy: ReservePolicy {nonce: gen__policy_nonce + 1}, balance: next_balance};
        State gen__0_route_physical_next = State {gen__reserve_asset_template: gen__reserve_asset_template, gen__wallet_asset_template: gen__wallet_asset_template, owner_kind: next_asset.owner_kind, owner_id: next_asset.owner_id, policy: blake3(byte[](next_asset.policy.nonce as byte[8])), balance: next_asset.balance};
        validateOutputStateWithTemplate(gen__next_output_idx, gen__0_route_physical_next, gen__wallet_asset_prefix, gen__wallet_asset_suffix, gen__wallet_asset_template);
    }
}
