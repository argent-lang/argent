pragma silverscript ^0.1.0;

contract Batch(byte[32] gen__init_account_template, int init_marker) {
    struct BatchState {
        int marker;
    }

    struct AccountState {
        int balance;
    }

    byte[32] gen__account_template = gen__init_account_template;

    int marker = init_marker;

    int constant MAX_INPUT_ACCOUNTS = 2;

    int constant MAX_OUTPUT_ACCOUNTS = 3;

    function gen__checked_range_index(int gen__range_index, int gen__range_count): int {
        require(gen__range_index >= 0);
        require(gen__range_index < gen__range_count);
        return(gen__range_index);
    }

    entry rebalance(byte[] gen__account_prefix, byte[] gen__account_suffix) {
        byte[32] gen__cov_id = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputIdx(gen__cov_id, 0) == this.activeInputIndex);
        int gen__accounts_count = OpCovInputCount(gen__cov_id) - 1;
        require(gen__accounts_count >= 0);
        require(gen__accounts_count <= 2);
        AccountState[] gen__accounts_authored_states;
        for (gen__accounts_position, 0, gen__accounts_count, 2) {
            int gen__accounts_input_idx = OpCovInputIdx(gen__cov_id, 1 + gen__accounts_position);
            AccountState gen__accounts_state = readInputStateWithTemplate(gen__accounts_input_idx, gen__account_prefix.length, gen__account_suffix.length, gen__account_template);
            gen__accounts_authored_states = gen__accounts_authored_states.append(gen__accounts_state);
        }
        int gen__next_output_count = OpAuthOutputCount(this.activeInputIndex);
        require(gen__next_output_count >= 1);
        require(gen__next_output_count <= 3);
        require(OpCovOutputCount(gen__cov_id) == OpAuthOutputCount(this.activeInputIndex));
        AccountState[] next_states;
        AccountState reserve = AccountState {balance: 0};
        next_states = next_states.append(reserve);
        for (i, 0, gen__accounts_count, MAX_INPUT_ACCOUNTS) {
            AccountState next_state = AccountState {balance: gen__accounts_authored_states[gen__checked_range_index(i, gen__accounts_count)].balance};
            next_states = next_states.append(next_state);
            require(tx.outputs[OpAuthOutputIdx(this.activeInputIndex, gen__checked_range_index(i + 1, gen__next_output_count))].value == tx.inputs[OpCovInputIdx(gen__cov_id, 1 + gen__checked_range_index(i, gen__accounts_count))].value);
        }
        require(next_states.length == gen__next_output_count);
        for (gen__next_output_position, 0, gen__next_output_count, 3) {
            AccountState gen__0_route_source_next = next_states[gen__next_output_position];
            validateOutputStateWithTemplate(OpAuthOutputIdx(this.activeInputIndex, gen__next_output_position), gen__0_route_source_next, gen__account_prefix, gen__account_suffix, gen__account_template);
        }
    }
}
