pragma silverscript ^0.1.0;

contract Batch(byte[32] gen__init_account_template, int init_marker) {
    struct BatchState {
        int marker;
    }

    struct AccountState {
        int balance;
    }

    byte[32] gen__account_template = gen__init_account_template;

    int marker = init_marker;

    int constant MAX_ACCOUNTS = 3;

    function gen__checked_range_index(int gen__range_index, int gen__range_count): int {
        require(gen__range_index >= 0);
        require(gen__range_index < gen__range_count);
        return(gen__range_index);
    }

    entry distribute(byte[] gen__account_prefix, byte[] gen__account_suffix) {
        int gen__first_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        int gen__next_output_count = OpAuthOutputCount(this.activeInputIndex) - 2;
        require(gen__next_output_count >= 1);
        require(gen__next_output_count <= 3);
        int gen__last_output_idx = OpAuthOutputIdx(this.activeInputIndex, OpAuthOutputCount(this.activeInputIndex) - 1);
        AccountState first_state = AccountState {balance: 0};
        AccountState[] next_states;
        for (i, 0, gen__next_output_count, MAX_ACCOUNTS) {
            AccountState next_state = AccountState {balance: i + 1};
            next_states = next_states.append(next_state);
            require(tx.outputs[OpAuthOutputIdx(this.activeInputIndex, 1 + gen__checked_range_index(i, gen__next_output_count))].value >= 0);
        }
        AccountState last_state = AccountState {balance: gen__next_output_count + 1};
        validateOutputStateWithTemplate(gen__first_output_idx, first_state, gen__account_prefix, gen__account_suffix, gen__account_template);
        require(next_states.length == gen__next_output_count);
        for (gen__next_output_position, 0, gen__next_output_count, 3) {
            AccountState gen__1_route_source_next = next_states[gen__next_output_position];
            validateOutputStateWithTemplate(OpAuthOutputIdx(this.activeInputIndex, 1 + gen__next_output_position), gen__1_route_source_next, gen__account_prefix, gen__account_suffix, gen__account_template);
        }
        validateOutputStateWithTemplate(gen__last_output_idx, last_state, gen__account_prefix, gen__account_suffix, gen__account_template);
    }
}
