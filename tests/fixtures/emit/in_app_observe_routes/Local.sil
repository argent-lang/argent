pragma silverscript ^0.1.0;

contract Local(byte[32] gen__init_foreign_template, byte[32] gen__init_target_template, byte[32] init_foreign_id, int init_steps) {
    struct ForeignState {
        int amount;
    }

    struct LocalState {
        byte[32] foreign_id;
        int steps;
    }

    struct TargetState {
        int units;
    }

    struct Gen__ForeignState {
        byte[32] gen__target_template;
        int amount;
    }

    byte[32] gen__foreign_template = gen__init_foreign_template;

    byte[32] gen__target_template = gen__init_target_template;

    byte[32] foreign_id = init_foreign_id;

    int steps = init_steps;

    function add_one(int gen__glob_value): int {
        return(gen__glob_value + 1);
    }

    function foreign_identity(ForeignState value): ForeignState {
        return(value);
    }

    function snapshot(): LocalState {
        return(LocalState {foreign_id: foreign_id, steps: steps});
    }

    function read_steps(LocalState value): int {
        return(value.steps);
    }

    function incremented_steps(): int {
        return(add_one(read_steps(snapshot())));
    }

    function next_state(int extra_steps): LocalState {
        return(LocalState {foreign_id: foreign_id, steps: incremented_steps() + extra_steps});
    }

    entry step(int gen__foreign_prefix_len, int gen__foreign_suffix_len) {
        byte[32] gen__remote_cov_id = foreign_id;
        require(OpCovInputCount(gen__remote_cov_id) == 1);
        require(OpCovOutputCount(gen__remote_cov_id) == 1);
        int gen__remote_src_input_idx = OpCovInputIdx(gen__remote_cov_id, 0);
        Gen__ForeignState gen__remote_src_state = readInputStateWithTemplate(gen__remote_src_input_idx, gen__foreign_prefix_len, gen__foreign_suffix_len, gen__foreign_template);
        int gen__remote_remote_next_output_idx = OpCovOutputIdx(gen__remote_cov_id, 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        ForeignState next_foreign = foreign_identity(ForeignState {amount: gen__remote_src_state.amount});
        Gen__ForeignState gen__0_route_physical_remote_next = Gen__ForeignState {gen__target_template: gen__target_template, amount: next_foreign.amount};
        validateOutputStateWithInputTemplate(gen__remote_remote_next_output_idx, gen__0_route_physical_remote_next, gen__remote_src_input_idx, gen__foreign_prefix_len, gen__foreign_suffix_len, gen__foreign_template);
        LocalState gen__1_route_source_next = next_state(0);
        State gen__1_route_physical_next = State {gen__foreign_template: gen__foreign_template, gen__target_template: gen__target_template, foreign_id: gen__1_route_source_next.foreign_id, steps: gen__1_route_source_next.steps};
        validateOutputState(gen__next_output_idx, gen__1_route_physical_next);
    }
}
