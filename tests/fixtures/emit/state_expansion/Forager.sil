pragma silverscript ^0.1.0;

contract Forager(byte[32] init_strategy, int init_energy) {
    struct ForagerState {
        ForagerStrategy strategy;
        int energy;
    }

    struct AgentCapsule {
        byte[32] strategy;
        int energy;
    }

    struct ForagerStrategy {
        int hunger;
    }

    byte[32] strategy = init_strategy;

    int energy = init_energy;

    entry hold(byte[8] gen__strategy_forager_strategy_preimage) {
        require(blake3(byte[](gen__strategy_forager_strategy_preimage)) == strategy);
        int gen__strategy_hunger = OpBin2Num(gen__strategy_forager_strategy_preimage.slice(0, 8));
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int gen__next_output_idx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(energy > 0);
        ForagerState next_state = ForagerState {strategy: ForagerStrategy {hunger: gen__strategy_hunger + 1}, energy: energy - 1};
        State gen__0_route_physical_next = State {strategy: blake3(byte[](next_state.strategy.hunger as byte[8])), energy: next_state.energy};
        validateOutputState(gen__next_output_idx, gen__0_route_physical_next);
    }
}
