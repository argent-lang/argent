state ControllerState {
    actor_type<PairState> pair_type;
    int launches;
}

state PairState {
    int amount;
}

state AnchorState {
    int amount;
}

actor Controller owns ControllerState {
    entry advance(cov_id pair_id, int spawned_amount)
    observes existing by pair_id {
        inputs {
            anchor: Anchor,
        }
        outputs {
            pair: self.pair_type,
        }
    }
    spawns newborn by newborn_id {
        outputs {
            pair: self.pair_type,
        }
    }
    emits next: Controller {
        PairState observed_next = {
            amount: existing.inputs.anchor.state.amount + 1,
        };
        PairState spawned = {
            amount: spawned_amount,
        };
        ControllerState next = {
            pair_type: pair_type,
            launches: launches + 1,
        };

        require existing.outputs become {
            pair <- self.pair_type(observed_next),
        };
        unrestricted(newborn.outputs.pair.value);
        require newborn.outputs become {
            pair <- self.pair_type(spawned),
        };
        unrestricted(next.value);
        become next <- Controller(next);
    }
}

actor Anchor owns AnchorState {
    entry advance() emits next: Pair {
        PairState next = {
            amount: amount + 1,
        };
        unrestricted(next.value);
        become next <- Pair(next);
    }
}

actor Pair owns PairState {
    entry keep() emits next: Pair {
        unrestricted(next.value);
        become next <- Pair(self.state);
    }
}

app SharedActorWitness {
    actor Controller;
    actor Anchor;
    actor Pair;
}
