state SharedState {
    int left;
    int right;
}

state ForeignState {
    int marker;
}

const int SHARED_COUNT = 2;

fn global_identity(SharedState value) -> SharedState {
    SharedState local = SharedState {
        left: value.left,
        right: value.right,
    };
    SharedState[2] fixed_literal = SharedState[2]{ value, local };
    SharedState[_] inferred_literal = SharedState[_]{ value, local };
    SharedState[SHARED_COUNT] symbolic_literal = SharedState[SHARED_COUNT]{ value, local };
    SharedState[] dynamic_literal = SharedState[]{ value, local };
    SharedState {
        left: int copied_left,
        right: int copied_right,
    } = local;
    return SharedState {
        left: copied_left,
        right: copied_right,
    };
}

fn global_fixed(SharedState[2] values) -> SharedState[2] {
    return values;
}

fn global_dynamic(SharedState[] values) -> SharedState[] {
    return values;
}

actor Aligned owns SharedState {
    fn actor_identity(SharedState value) -> SharedState {
        SharedState local = SharedState {
            left: value.left,
            right: value.right,
        };
        return global_identity(local);
    }

    fn actor_fixed(SharedState[2] values) -> SharedState[2] {
        return global_fixed(values);
    }

    fn actor_dynamic(SharedState[] values) -> SharedState[] {
        return global_dynamic(values);
    }

    entry inspect(SharedState value, SharedState[2] fixed, SharedState[] dynamic) emits none {
        SharedState scalar = actor_identity(global_identity(value));
        SharedState constructed = SharedState {
            left: scalar.left,
            right: scalar.right,
        };
        SharedState reassigned = constructed;
        reassigned = global_identity(value);
        SharedState {
            left: int extracted_left,
            right: int extracted_right,
        } = reassigned;
        SharedState[2] fixed_result = actor_fixed(global_fixed(fixed));
        SharedState[] dynamic_result = actor_dynamic(global_dynamic(dynamic));

        require(scalar.left + scalar.right + extracted_left + extracted_right >= 0);
        require(fixed_result[0].left >= 0);
        require(dynamic_result.length >= 0);
    }
}

actor Routed owns SharedState {
    fn actor_identity(SharedState value) -> SharedState {
        SharedState local = SharedState {
            left: value.left,
            right: value.right,
        };
        return global_identity(local);
    }

    fn actor_fixed(SharedState[2] values) -> SharedState[2] {
        return global_fixed(values);
    }

    fn actor_dynamic(SharedState[] values) -> SharedState[] {
        return global_dynamic(values);
    }

    entry advance(SharedState value, SharedState[2] fixed, SharedState[] dynamic) emits next: Routed {
        SharedState scalar = actor_identity(global_identity(value));
        SharedState constructed = SharedState {
            left: scalar.left,
            right: scalar.right,
        };
        SharedState[2] fixed_result = actor_fixed(global_fixed(fixed));
        SharedState[] dynamic_result = actor_dynamic(global_dynamic(dynamic));

        require(constructed.left + constructed.right >= 0);
        require(fixed_result[0].left >= 0);
        require(dynamic_result.length >= 0);
        unrestricted(next.value);
        become next <- Routed(actor_identity(scalar));
    }

    entry export() emits next: Foreign {
        ForeignState next_state = {
            marker: left + right,
        };

        unrestricted(next.value);
        become next <- Foreign(next_state);
    }
}

actor Foreign owns ForeignState {
    entry hold() emits none {
        require(marker >= 0);
    }
}

actor Reader owns ForeignState {
    entry inspect(SharedState value, SharedState[2] fixed, SharedState[] dynamic, byte[32] expected_peer_digest)
    consumes {
        peer: Routed,
    }
    emits none {
        SharedState[2] fixed_from_peer = SharedState[_]{ value, state(peer) };
        SharedState[] dynamic_from_peer = SharedState[]{ state(peer) };
        SharedState[3] fixed_appended = fixed.append(state(peer));
        SharedState[] appended = dynamic.append(state(peer));
        appended = appended.append(state(peer));
        SharedState indexed = global_fixed(fixed)[0];
        SharedState passed = global_identity(global_dynamic(dynamic)[0]);
        byte[32] peer_digest = digest(state(peer));

        require(fixed_from_peer[1].left + dynamic_from_peer[0].right >= 0);
        require(fixed_appended[2].right >= 0);
        require(appended.length >= dynamic.length);
        require(dynamic.append(state(peer)).length > dynamic.length);
        require(SharedState[]{ state(peer) }.length == 1);
        require(indexed.left + passed.right + marker >= 0);
        require(peer_digest == expected_peer_digest);
    }
}

app Test {
    actor Aligned;
    actor Routed;
    actor Foreign;
    actor Reader;
}
